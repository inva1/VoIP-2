# ============================================================
# VoIP Business Solution — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Flask
FLASK_ENV=development
FLASK_APP=voip_backend/run.py
SECRET_KEY=your-secret-key-generate-with-python-c-'import secrets; print(secrets.token_hex(32))'

# Database (PostgreSQL)
DATABASE_URL=postgresql://voip_admin:change_me@localhost:5432/voip_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-generate-with-secrets-module
JWT_ACCESS_TOKEN_EXPIRES_HOURS=1
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# KYC Provider (placeholder)
# KYC_PROVIDER_API_KEY=
# KYC_PROVIDER_URL=

# SMS Provider (placeholder)
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_URL=

# DID Provider (placeholder)
# DID_PROVIDER_API_KEY=
# DID_PROVIDER_URL=

# File Uploads
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH_MB=16

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# AGI Scripts (for Asterisk to call back to Flask)
AGI_BACKEND_URL=http://api:5000
AGI_API_KEY=change-this-to-a-secure-key
